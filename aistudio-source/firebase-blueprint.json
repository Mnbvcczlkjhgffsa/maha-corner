{
  "entities": {
    "Follower": {
      "title": "Follower",
      "description": "A regular citizen or CSC operator who consented and subscribed to MAHA CORNER updates. Contains PII and is readable only by verified Admin.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique SHA-256 mobile hash identifier matching the document ID.",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Full name or center name of the follower.",
          "minLength": 2,
          "maxLength": 80
        },
        "mobile": {
          "type": "string",
          "description": "10-digit Indian mobile / WhatsApp number.",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[6-9][0-9]{9}$"
        },
        "consentGiven": {
          "type": "boolean",
          "description": "Explicit consent confirmation given by the user before saving personal info."
        },
        "interests": {
          "type": "array",
          "description": "Selected update categories (1 to 6 items)."
        },
        "source": {
          "type": "string",
          "description": "UI entry point used to follow.",
          "minLength": 2,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp recorded at registration."
        },
        "createdAtIso": {
          "type": "string",
          "format": "date-time",
          "description": "ISO date-time string for display and filtering.",
          "minLength": 10,
          "maxLength": 40
        }
      },
      "required": [
        "id",
        "name",
        "mobile",
        "consentGiven",
        "interests",
        "source",
        "createdAt",
        "createdAtIso"
      ]
    },
    "FollowerHash": {
      "title": "FollowerHash",
      "description": "Zero-PII duplicate-prevention index keyed by SHA-256 hash of mobile number.",
      "type": "object",
      "properties": {
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of registration."
        }
      },
      "required": ["createdAt"]
    },
    "PortalStats": {
      "title": "PortalStats",
      "description": "Public aggregate follower counter without any personal data.",
      "type": "object",
      "properties": {
        "totalFollowers": {
          "type": "number",
          "description": "Total number of registered followers."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last increment server timestamp."
        }
      },
      "required": ["totalFollowers", "updatedAt"]
    },
    "LiveUpdate": {
      "title": "LiveUpdate",
      "description": "Announcement published by Admin for all followers.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique update ID.",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Announcement headline.",
          "minLength": 2,
          "maxLength": 160
        },
        "message": {
          "type": "string",
          "description": "Announcement body.",
          "minLength": 2,
          "maxLength": 800
        },
        "targetTab": {
          "type": "string",
          "description": "Destination tab in app.",
          "minLength": 2,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp."
        }
      },
      "required": ["id", "title", "message", "targetTab", "createdAt"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Additional authorized admin UID marker.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "Admin email address.",
          "maxLength": 160
        },
        "addedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        }
      },
      "required": ["email", "addedAt"]
    },
    "OwnerPoster": {
      "title": "OwnerPoster",
      "description": "Official scheme/farmer poster uploaded by the Owner, stored persistently in Firestore for all citizens and CSC operators.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique poster document ID matching path posterId.",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Poster headline or scheme title.",
          "minLength": 1,
          "maxLength": 140
        },
        "category": {
          "type": "string",
          "description": "Scheme or service category label.",
          "minLength": 1,
          "maxLength": 60
        },
        "badge": {
          "type": "string",
          "description": "Display badge on poster card.",
          "minLength": 1,
          "maxLength": 40
        },
        "imageUrl": {
          "type": "string",
          "description": "Compressed raster data URL (PNG/JPEG/WEBP <= 950KB).",
          "minLength": 20,
          "maxLength": 950000,
          "pattern": "^data:image/(png|jpeg|jpg|webp);base64,[A-Za-z0-9+/=]+$"
        },
        "dateAdded": {
          "type": "string",
          "description": "Localized display date string.",
          "minLength": 1,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when published."
        },
        "createdAtMs": {
          "type": "number",
          "description": "Epoch milliseconds for sorting."
        }
      },
      "required": [
        "id",
        "title",
        "category",
        "badge",
        "imageUrl",
        "dateAdded",
        "createdAt",
        "createdAtMs"
      ]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Support or grievance inquiry submitted via Contact Us form. Contains PII and is readable only by verified Admin.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique inquiry ID matching document ID.",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Sender full name.",
          "minLength": 2,
          "maxLength": 80
        },
        "mobile": {
          "type": "string",
          "description": "10-digit Indian mobile number.",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[6-9][0-9]{9}$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Sender email address.",
          "minLength": 5,
          "maxLength": 160
        },
        "message": {
          "type": "string",
          "description": "Grievance, question, or feedback message.",
          "minLength": 5,
          "maxLength": 1500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server submission timestamp."
        },
        "createdAtMs": {
          "type": "number",
          "description": "Epoch milliseconds for sorting."
        }
      },
      "required": ["id", "name", "mobile", "email", "message", "createdAt", "createdAtMs"]
    },
    "UserPoster": {
      "title": "UserPoster",
      "description": "Generated branded poster saved personally by an authenticated user in My Posters, persisted in Firestore and manually deletable only by its owner.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique poster document ID matching path posterId.",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "description": "Firebase Auth UID of the user who saved this poster.",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Poster title or scheme label.",
          "minLength": 1,
          "maxLength": 140
        },
        "centerName": {
          "type": "string",
          "description": "Shop or center name stamped on the poster.",
          "minLength": 1,
          "maxLength": 100
        },
        "category": {
          "type": "string",
          "description": "Poster category.",
          "minLength": 1,
          "maxLength": 60
        },
        "imageUrl": {
          "type": "string",
          "description": "Compressed raster data URL of the final generated poster (<= 450KB).",
          "minLength": 20,
          "maxLength": 450000,
          "pattern": "^data:image/(png|jpeg|jpg|webp);base64,[A-Za-z0-9+/=]+$"
        },
        "dateSaved": {
          "type": "string",
          "description": "Localized display date string.",
          "minLength": 1,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when saved."
        },
        "createdAtMs": {
          "type": "number",
          "description": "Epoch milliseconds for client-side sorting."
        }
      },
      "required": [
        "id",
        "ownerUid",
        "title",
        "centerName",
        "category",
        "imageUrl",
        "dateSaved",
        "createdAt",
        "createdAtMs"
      ]
    }
  },
  "firestore": {
    "/followers/{followerId}": {
      "schema": { "$ref": "#/entities/Follower" },
      "description": "PII follower records (name, mobile, consent, timestamp). Create-only for new hashed IDs; get/list/update/delete strictly restricted to verified Admin."
    },
    "/follower_hashes/{hashId}": {
      "schema": { "$ref": "#/entities/FollowerHash" },
      "description": "Zero-PII duplicate guard document atomically paired with /followers/{hashId}."
    },
    "/portal_stats/{statId}": {
      "schema": { "$ref": "#/entities/PortalStats" },
      "description": "Public aggregate counters (summary document only). Zero PII."
    },
    "/live_updates/{updateId}": {
      "schema": { "$ref": "#/entities/LiveUpdate" },
      "description": "Public announcements readable by all visitors and writable only by verified Admin."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Trusted admin role documents managed solely by verified Admin."
    },
    "/owner_posters/{posterId}": {
      "schema": { "$ref": "#/entities/OwnerPoster" },
      "description": "Public zero-PII gallery of official posters uploaded by verified Admin."
    },
    "/contact_messages/{messageId}": {
      "schema": { "$ref": "#/entities/ContactMessage" },
      "description": "PII citizen support/contact inquiries. Create-only for visitors; read/delete strictly restricted to verified Admin."
    },
    "/user_posters/{posterId}": {
      "schema": { "$ref": "#/entities/UserPoster" },
      "description": "User-owned saved posters in My Posters; readable, creatable, and manually deletable only by the owning authenticated user."
    }
  }
}